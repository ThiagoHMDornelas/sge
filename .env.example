SECRET_KEY='SUA CHAVE DJANGO'
SESSION_COOKIE_NAME=sge_sessionid
CSRF_COOKIE_NAME=sge_csrf

DEBUG=True

ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Desenvolvimento local (padrão): SQLite (db.sqlite3). Nenhum serviço extra.
DB_ENV=dev
ACTIVE_DB=sqlite

# PostgreSQL local (usado quando ACTIVE_DB=postgresql)
POSTGRES_DB=sge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Docker: descomente o bloco abaixo e remova o bloco de desenvolvimento acima.
# DB_ENV=prd
# ACTIVE_DB=postgresql
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=sge_db

# Criação de superusuário (usada com createsuperuser --noinput)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
